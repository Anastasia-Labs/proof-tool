+// PackLSBConstrained range-checks each part to its declared width, packs the
+// parts from least to most significant, and returns a byte that downstream
+// operations may safely treat as width-constrained. Widths must be positive
+// and sum to exactly eight. Reusing the same variable at the same width reuses
+// its already-emitted range constraint; it never assumes a caller-side proof.
+func (bf *Bytes) PackLSBConstrained(parts []frontend.Variable, widths []int) U8 {
+	if len(parts) == 0 || len(parts) != len(widths) {
+		panic("uints: constrained byte parts and widths must have the same nonzero length")
+	}
+	totalWidth := 0
+	for _, width := range widths {
+		if width < 1 || totalWidth+width > 8 {
+			panic("uints: constrained byte widths must be positive and total eight bits")
+		}
+		totalWidth += width
+	}
+	if totalWidth != 8 {
+		panic("uints: constrained byte widths must total eight bits")
+	}
+
+	packed := frontend.Variable(0)
+	offset := 0
+	for i, part := range parts {
+		bf.enforceBitWidth(part, widths[i])
+		packed = bf.api.Add(packed, bf.api.Mul(part, 1<<offset))
+		offset += widths[i]
+	}
+	return bf.packInternal(packed)
+}
+
+func (bf *Bytes) enforceBitWidth(value frontend.Variable, bits int) {
+	if constant, ok := bf.api.ConstantValue(value); ok {
+		if constant.Sign() < 0 || constant.BitLen() > bits {
+			panic(fmt.Sprintf("constant value %d is too large for %d bits", constant, bits))
+		}
+		return
+	}
+	if hashed, ok := value.(interface{ HashCode() [16]byte }); ok {
+		key := constrainedWidthKey{hash: hashed.HashCode(), bits: bits}
+		if _, ok := bf.constrainedBits[key]; ok {
+			return
+		}
+		bf.constrainedBits[key] = struct{}{}
+	}
+	bf.rchecker.Check(value, bits)
+}
