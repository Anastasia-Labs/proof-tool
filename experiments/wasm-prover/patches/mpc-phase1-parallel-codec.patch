+func writeG1Points(writer io.Writer, points []curve.G1Affine) (n int64, err error) {
+	for start := 0; start < len(points); start += srsCodecChunkSize {
+		end := min(start+srsCodecChunkSize, len(points))
+		chunk := make([]byte, (end-start)*curve.SizeOfG1AffineCompressed)
+		utils.Parallelize(end-start, func(workerStart, workerEnd int) {
+			for i := workerStart; i < workerEnd; i++ {
+				encoded := points[start+i].Bytes()
+				copy(chunk[i*curve.SizeOfG1AffineCompressed:], encoded[:])
+			}
+		})
+		dn, writeErr := writeAll(writer, chunk)
+		n += int64(dn)
+		if writeErr != nil {
+			return n, writeErr
+		}
+	}
+	return n, nil
+}
