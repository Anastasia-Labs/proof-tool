+func writeAll(writer io.Writer, data []byte) (int, error) {
+	written := 0
+	for len(data) > 0 {
+		n, err := writer.Write(data)
+		written += n
+		data = data[n:]
+		if err != nil {
+			return written, err
+		}
+		if n == 0 {
+			return written, io.ErrShortWrite
+		}
+	}
+	return written, nil
+}
